<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container">
  <h1 class="page-title">List New Product</h1>
  <form method="POST" action="/products/seller/new" enctype="multipart/form-data" class="product-form">
    <%- include('../partials/csrf') %>
    <div class="form-grid">
      <div class="form-group">
        <label>Product Title *</label>
        <input type="text" name="title" required placeholder="Product name" />
      </div>
      <div class="form-group">
        <label>Category *</label>
        <select name="category" required>
          <option value="">Select category</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>"><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Condition</label>
        <select name="condition">
          <option value="New">New</option>
          <option value="Like New">Like New</option>
          <option value="Good" selected>Good</option>
          <option value="Fair">Fair</option>
          <option value="Poor">Poor</option>
        </select>
      </div>
      <div class="form-group">
        <label>Price ($) *</label>
        <input type="number" name="price" required min="0" step="0.01" placeholder="0.00" />
      </div>
      <div class="form-group">
        <label>Stock *</label>
        <input type="number" name="stock" required min="0" value="1" />
      </div>
      <div class="form-group form-full">
        <label>Description *</label>
        <textarea name="description" required rows="4" placeholder="Describe your product..."></textarea>
      </div>
      <div class="form-group form-full">
        <label>Product Images (max 5)</label>
        <input type="file" name="images" accept="image/*" multiple />
      </div>
      <div class="form-group form-full">
        <label>Tags (comma separated)</label>
        <input type="text" name="tags" placeholder="e.g. laptop, apple, gaming" />
      </div>
      <div class="form-group form-full">
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="isAvailableForSale" checked /> Available for Sale
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="isAvailableForRent" id="rentCheck" onchange="toggleRental(this)" /> Available for Rent
          </label>
        </div>
      </div>
      <div id="rental-fields" class="rental-fields hidden form-full">
        <div class="form-grid">
          <div class="form-group">
            <label>Rental Price per Day ($)</label>
            <input type="number" name="rentalPricePerDay" min="0" step="0.01" value="0" placeholder="0.00" />
          </div>
          <div class="form-group">
            <label>Security Deposit ($)</label>
            <input type="number" name="securityDeposit" min="0" step="0.01" value="0" placeholder="0.00" />
          </div>
        </div>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn-primary">List Product</button>
      <a href="/seller/dashboard" class="btn-outline">Cancel</a>
    </div>
  </form>
</div>
<script>
function toggleRental(checkbox) {
  document.getElementById('rental-fields').classList.toggle('hidden', !checkbox.checked);
}
</script>
<%- include('../partials/footer') %>
