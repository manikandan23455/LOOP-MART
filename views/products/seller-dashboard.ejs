<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container">
  <div class="dashboard-header">
    <h1 class="page-title">Seller Dashboard</h1>
    <a href="/products/seller/new" class="btn-primary">+ List New Product</a>
  </div>

  <% if (products.length === 0) { %>
    <div class="empty-state">
      <p>You haven't listed any products yet.</p>
      <a href="/products/seller/new" class="btn-primary">List Your First Product</a>
    </div>
  <% } else { %>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th>For Sale</th>
            <th>For Rent</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(product) { %>
            <tr>
              <td><%= product.title %></td>
              <td><%= product.category %></td>
              <td>$<%= product.price.toFixed(2) %></td>
              <td><%= product.stock %></td>
              <td>
                <% if (product.isApproved) { %>
                  <span class="badge-success">Approved</span>
                <% } else { %>
                  <span class="badge-pending">Pending</span>
                <% } %>
              </td>
              <td><%= product.isAvailableForSale ? '&#x2705;' : '&#x274C;' %></td>
              <td><%= product.isAvailableForRent ? '&#x2705;' : '&#x274C;' %></td>
              <td class="actions-cell">
                <a href="/products/seller/edit/<%= product._id %>" class="btn-outline btn-sm">Edit</a>
                <form method="POST" action="/products/seller/delete/<%= product._id %>?_method=DELETE" style="display:inline;"
                  onsubmit="return confirm('Delete this product?')">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
