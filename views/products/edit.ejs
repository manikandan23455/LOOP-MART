<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container">
  <h1 class="page-title">Edit Product</h1>
  <form method="POST" action="/products/seller/edit/<%= product._id %>?_method=PUT" enctype="multipart/form-data" class="product-form">
    <%- include('../partials/csrf') %>
    <div class="form-grid">
      <div class="form-group">
        <label>Product Title *</label>
        <input type="text" name="title" required value="<%= product.title %>" />
      </div>
      <div class="form-group">
        <label>Category *</label>
        <select name="category" required>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat %>" <%= product.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Condition</label>
        <select name="condition">
          <% ['New','Like New','Good','Fair','Poor'].forEach(function(c) { %>
            <option value="<%= c %>" <%= product.condition === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Price ($) *</label>
        <input type="number" name="price" required min="0" step="0.01" value="<%= product.price %>" />
      </div>
      <div class="form-group">
        <label>Stock *</label>
        <input type="number" name="stock" required min="0" value="<%= product.stock %>" />
      </div>
      <div class="form-group form-full">
        <label>Description *</label>
        <textarea name="description" required rows="4"><%= product.description %></textarea>
      </div>
      <% if (product.images && product.images.length > 0) { %>
        <div class="form-group form-full">
          <label>Current Images</label>
          <div class="current-images">
            <% product.images.forEach(function(img) { %>
              <img src="<%= img %>" alt="Product image" class="current-img-thumb" />
            <% }) %>
          </div>
        </div>
      <% } %>
      <div class="form-group form-full">
        <label>Replace Images (optional)</label>
        <input type="file" name="images" accept="image/*" multiple />
      </div>
      <div class="form-group form-full">
        <label>Tags (comma separated)</label>
        <input type="text" name="tags" value="<%= product.tags ? product.tags.join(', ') : '' %>" placeholder="e.g. laptop, apple, gaming" />
      </div>
      <div class="form-group form-full">
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="isAvailableForSale" <%= product.isAvailableForSale ? 'checked' : '' %> /> Available for Sale
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="isAvailableForRent" id="rentCheck" <%= product.isAvailableForRent ? 'checked' : '' %> onchange="toggleRental(this)" /> Available for Rent
          </label>
        </div>
      </div>
      <div id="rental-fields" class="rental-fields <%= product.isAvailableForRent ? '' : 'hidden' %> form-full">
        <div class="form-grid">
          <div class="form-group">
            <label>Rental Price per Day ($)</label>
            <input type="number" name="rentalPricePerDay" min="0" step="0.01" value="<%= product.rentalPricePerDay %>" />
          </div>
          <div class="form-group">
            <label>Security Deposit ($)</label>
            <input type="number" name="securityDeposit" min="0" step="0.01" value="<%= product.securityDeposit %>" />
          </div>
        </div>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn-primary">Update Product</button>
      <a href="/seller/dashboard" class="btn-outline">Cancel</a>
    </div>
  </form>
</div>
<script>
function toggleRental(checkbox) {
  document.getElementById('rental-fields').classList.toggle('hidden', !checkbox.checked);
}
</script>
<%- include('../partials/footer') %>
