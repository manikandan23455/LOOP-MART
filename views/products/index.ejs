<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container">
  <h1 class="page-title">Browse Products</h1>

  <form method="GET" action="/products" class="search-form">
    <div class="search-row">
      <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Search products..." class="search-input" />
      <select name="category" class="select-input">
        <option value="">All Categories</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
      <input type="number" name="minPrice" value="<%= query.minPrice || '' %>" placeholder="Min $" class="price-input" />
      <input type="number" name="maxPrice" value="<%= query.maxPrice || '' %>" placeholder="Max $" class="price-input" />
      <select name="sort" class="select-input">
        <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Newest</option>
        <option value="price_asc" <%= query.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
        <option value="price_desc" <%= query.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
      </select>
      <button type="submit" class="btn-primary">Search</button>
      <a href="/products" class="btn-outline">Clear</a>
    </div>
  </form>

  <% if (products.length === 0) { %>
    <div class="empty-state">
      <p>No products found.</p>
      <a href="/products" class="btn-outline">Clear Filters</a>
    </div>
  <% } else { %>
    <p class="result-count"><%= products.length %> product<%= products.length !== 1 ? 's' : '' %> found</p>
    <div class="products-grid">
      <% products.forEach(function(product) { %>
        <div class="product-card">
          <% if (product.images && product.images.length > 0) { %>
            <img src="<%= product.images[0] %>" alt="<%= product.title %>" class="product-img" />
          <% } else { %>
            <div class="product-img-placeholder">&#x1F4F7;</div>
          <% } %>
          <div class="product-info">
            <span class="product-category"><%= product.category %></span>
            <h4><%= product.title %></h4>
            <p class="product-condition"><%= product.condition %></p>
            <p class="product-price">$<%= product.price.toFixed(2) %></p>
            <% if (product.isAvailableForRent) { %>
              <span class="badge-rent">&#x1F504; Rentable</span>
            <% } %>
            <div class="product-actions">
              <a href="/products/<%= product._id %>" class="btn-primary btn-sm">View</a>
              <% if (sessionUser) { %>
                <form method="POST" action="/cart/add/<%= product._id %>" style="display:inline;">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="btn-cart btn-sm">+ Cart</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
