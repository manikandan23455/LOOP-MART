<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container">
  <h1 class="page-title">My Profile</h1>
  <div class="profile-card">
    <div class="profile-header">
      <div class="profile-avatar">&#128100;</div>
      <div>
        <h2><%= user.name %></h2>
        <span class="role-badge role-<%= user.role %>"><%= user.role %></span>
      </div>
    </div>
    <form method="POST" action="/auth/profile" class="profile-form">
      <%- include('../partials/csrf') %>
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" value="<%= user.name %>" required />
      </div>
      <div class="form-group">
        <label>Email (read only)</label>
        <input type="email" value="<%= user.email %>" readonly />
      </div>
      <div class="form-group">
        <label>Phone</label>
        <input type="text" name="phone" value="<%= user.phone || '' %>" placeholder="Phone number" />
      </div>
      <div class="form-group">
        <label>Address</label>
        <textarea name="address" rows="3" placeholder="Shipping address"><%= user.address || '' %></textarea>
      </div>
      <button type="submit" class="btn-primary">Update Profile</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
