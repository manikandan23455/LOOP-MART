<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container">
  <h1 class="page-title">My Orders</h1>
  <% if (orders.length === 0) { %>
    <div class="empty-state">
      <p>You haven't placed any orders yet.</p>
      <a href="/products" class="btn-primary">Start Shopping</a>
    </div>
  <% } else { %>
    <div class="orders-list">
      <% orders.forEach(function(order) { %>
        <div class="order-card">
          <div class="order-header">
            <span class="order-id">Order #<%= order._id %></span>
            <span class="order-status status-<%= order.orderStatus.toLowerCase() %>"><%= order.orderStatus %></span>
          </div>
          <div class="order-items-preview">
            <% order.items.forEach(function(item) { %>
              <span class="order-item-name">
                <%= item.product ? item.product.title : 'Product' %> x<%= item.quantity %>
              </span>
            <% }) %>
          </div>
          <div class="order-footer">
            <span class="order-total">Total: $<%= order.totalAmount.toFixed(2) %></span>
            <span class="order-date"><%= new Date(order.createdAt).toLocaleDateString() %></span>
            <a href="/orders/<%= order._id %>" class="btn-outline btn-sm">View Details</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
