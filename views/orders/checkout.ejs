<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<div class="container">
  <h1 class="page-title">Checkout</h1>
  <div class="checkout-layout">
    <div class="checkout-summary">
      <h3>Order Summary</h3>
      <% cart.forEach(function(item) { %>
        <div class="checkout-item">
          <span><%= item.title %> x <%= item.quantity %></span>
          <span>$<%= (item.price * item.quantity).toFixed(2) %></span>
        </div>
      <% }) %>
      <hr />
      <div class="checkout-total">
        <strong>Total: $<%= total.toFixed(2) %></strong>
      </div>
    </div>
    <form method="POST" action="/orders/checkout" class="checkout-form">
      <%- include('../partials/csrf') %>
      <div class="form-group">
        <label>Shipping Address *</label>
        <textarea name="shippingAddress" required rows="3" placeholder="Enter your full shipping address"></textarea>
      </div>
      <div class="form-group">
        <label>Payment Method</label>
        <select name="paymentMethod">
          <option value="Cash on Delivery">Cash on Delivery</option>
          <option value="Online Payment">Online Payment</option>
        </select>
      </div>
      <button type="submit" class="btn-primary btn-full">Place Order</button>
      <a href="/cart" class="btn-outline btn-full" style="margin-top:8px;">Back to Cart</a>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
